.page{padding:28rpx 24rpx 72rpx}.hero{margin-bottom:20rpx}.title-row{display:flex;justify-content:space-between;align-items:center}.title{font-size:42rpx;font-weight:750;letter-spacing:-1rpx}.about{padding:8rpx 14rpx;border:1rpx solid #c7d8f6;border-radius:10rpx;color:#2357a6;font-size:23rpx}.subtitle{display:block;margin-top:6rpx;color:#667085;font-size:24rpx}.search-help{margin-bottom:12rpx;padding:16rpx;border:1rpx solid #d9e5fa;border-radius:14rpx;background:#f8fbff;color:#4a5c78;font-size:23rpx}.help-title{color:#274e8f;font-weight:700}.search{height:84rpx;padding:0 24rpx;border:2rpx solid #dbe2ea;border-radius:18rpx;background:#fff;font-size:28rpx}.filters{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:14rpx}.filters-active{padding:12rpx;border:1rpx solid #bfd3fb;border-radius:16rpx;background:#eef4ff}.filter{display:flex;flex-direction:column;gap:4rpx;min-height:92rpx;padding:13rpx 16rpx;border:1rpx solid #e1e6ee;border-radius:14rpx;background:#fff;color:#667085;font-size:21rpx}.filter text:last-child{color:#172033;font-size:25rpx}.offense-filter{gap:8rpx}.offense-selects{display:grid;grid-template-columns:1fr;gap:8rpx}.offense-select{display:flex;flex-direction:column;gap:3rpx;min-width:0;color:#667085;font-size:19rpx}.offense-select text:last-child{overflow:hidden;color:#172033;font-size:21rpx;white-space:nowrap;text-overflow:ellipsis}.filter-tip{display:flex;align-items:center;gap:12rpx;margin-top:12rpx;padding:12rpx 14rpx;border:1rpx solid #bfd3fb;border-radius:12rpx;background:#eef4ff;color:#17458a;font-size:22rpx}.filter-tip button{margin-left:auto;padding:5rpx 12rpx;border:1rpx solid #9dbbf2;border-radius:8rpx;background:#fff;color:#17458a;font-size:22rpx;line-height:1.5}.bar{display:flex;justify-content:space-between;gap:14rpx;margin:22rpx 4rpx 14rpx;color:#667085;font-size:23rpx}.bar text:last-child{text-align:right}.empty{padding:90rpx 0;text-align:center;color:#98a2b3}.load-more{display:block;margin:24rpx auto;padding:14rpx 34rpx;border:1rpx solid #c7d8f6;border-radius:12rpx;background:#fff;color:#2357a6;font-size:25rpx}.end-hint{margin:24rpx auto;text-align:center;color:#667085;font-size:23rpx}.notice{margin-top:34rpx;padding:16rpx;border:1rpx solid #f2d89a;border-radius:14rpx;background:#fff8e8;color:#7a4a00;font-size:22rpx}.footer{display:flex;flex-direction:column;gap:7rpx;margin-top:32rpx;padding-top:22rpx;border-top:1rpx solid #e1e6ee;color:#667085;font-size:21rpx}
