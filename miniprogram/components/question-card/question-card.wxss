.card{margin:0 0 20rpx;padding:28rpx 30rpx;border:1rpx solid #e1e6ee;border-radius:22rpx;background:#fff;box-shadow:0 2rpx 8rpx rgba(16,24,40,.05)}.head{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap}.qid{color:#2357a6;font-size:30rpx;font-weight:700}.badge{padding:3rpx 12rpx;border:1rpx solid #d8dee8;border-radius:9rpx;color:#667085;font-size:22rpx}.primary{margin:16rpx 0 0;color:#475467;font-size:27rpx}.primary text{color:#2357a6;font-weight:700}.points{margin-top:16rpx}.point{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx;margin-top:10rpx;padding:10rpx 14rpx;border:1rpx solid #e1e6ee;border-radius:12rpx;background:#fafbfc;font-size:24rpx}.topic-name{font-weight:650}.page{font-weight:650}.bs{color:#087f6d}.jj{color:#a85b00}.more{display:inline-block;margin:16rpx 0 0;padding:8rpx 14rpx;border:1rpx solid #c7d8f6;border-radius:10rpx;background:#eef4ff;color:#2357a6;font-size:23rpx;line-height:1.4}
