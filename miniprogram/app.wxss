page{background:#f3f5f8;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.55}button::after{border:none}
.sticky-filters{position:sticky;top:0;z-index:20;padding:10rpx 0 14rpx;background:#f3f5f8}.back-to-filters{display:flex;flex:none;flex-direction:column;align-items:center;justify-content:center;width:88rpx!important;min-width:88rpx!important;max-width:88rpx!important;height:88rpx!important;position:fixed;right:24rpx;bottom:72rpx;z-index:30;margin:0;padding:0;border:1rpx solid #9dbbf2;border-radius:50%;box-sizing:border-box;overflow:hidden;background:rgba(255,255,255,.96);box-shadow:0 4rpx 16rpx rgba(35,87,166,.18);color:#17458a;font-size:16rpx;font-weight:650;line-height:1.25;white-space:nowrap}.back-to-filters text{display:block}.back-to-filters-armed{border-color:#2357a6;background:#2357a6;color:#fff}
